{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stay",
  "version": "0.1.0",
  "identifier": "com.stay.present",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stay",
        "url": "index.html",
        "width": 360,
        "height": 320,
        "minWidth": 320,
        "minHeight": 260,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "targets": "all"
  }
}
